<Window x:Class="WindowsMemoryReaper.Services.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Memory Reaper — Settings"
        Width="460" Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="RAMMap64.exe" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="RamMapPathBox" Grid.Column="0" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Padding="12,2" Click="Browse_Click"/>
        </Grid>

        <CheckBox x:Name="AutoCleanCheckBox" Grid.Row="2" Content="Enable automatic cleaning" Margin="0,18,0,6"/>

        <TextBlock Grid.Row="3" Text="Cleaning interval" FontWeight="SemiBold" Margin="0,6,0,6"/>
        <ComboBox x:Name="IntervalBox" Grid.Row="4" Width="160" HorizontalAlignment="Left">
            <ComboBoxItem Content="5 minutes"/>
            <ComboBoxItem Content="10 minutes"/>
            <ComboBoxItem Content="15 minutes"/>
            <ComboBoxItem Content="20 minutes"/>
            <ComboBoxItem Content="30 minutes"/>
            <ComboBoxItem Content="45 minutes"/>
            <ComboBoxItem Content="60 minutes"/>
            <ComboBoxItem Content="Custom..."/>
        </ComboBox>

        <TextBlock Grid.Row="5" Text="Operations to perform" FontWeight="SemiBold" Margin="0,14,0,6"/>
        <CheckBox x:Name="OpEwBox" Grid.Row="6" Content="Empty Working Sets (-Ew)" Margin="16,0,0,2"/>
        <CheckBox x:Name="OpEsBox" Grid.Row="7" Content="Empty System Working Set (-Es)" Margin="16,0,0,2"/>
        <CheckBox x:Name="OpEmBox" Grid.Row="8" Content="Empty Modified Page List (-Em)" Margin="16,0,0,2"/>
        <CheckBox x:Name="OpEtBox" Grid.Row="9" Content="Empty Standby List (-Et)" Margin="16,0,0,2"/>
        <CheckBox x:Name="OpE0Box" Grid.Row="10" Content="Empty Priority 0 Standby List (-E0)" Margin="16,0,0,2"/>

        <TextBlock x:Name="StatusText" Grid.Row="11" Margin="0,16,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>

        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Clean Now" Margin="0,0,8,0" Padding="12,3" Click="CleanNow_Click"/>
            <Button Content="Save" IsDefault="True" Margin="0,0,8,0" Padding="12,3" Click="Save_Click"/>
            <Button Content="Cancel" IsCancel="True" Padding="12,3" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>