<Window x:Class="WindowsMemoryReaper.Services.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Memory Reaper — Settings"
        Width="460" Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="RAMMap64.exe" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="RamMapPathBox" Grid.Column="0" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Padding="12,2" Click="Browse_Click"/>
        </Grid>

        <CheckBox x:Name="AutoCleanCheckBox" Grid.Row="2" Content="Enable automatic cleaning" Margin="0,18,0,6"/>

        <TextBlock Grid.Row="3" Text="Cleaning interval" FontWeight="SemiBold" Margin="0,6,0,6"/>
        <ComboBox x:Name="IntervalBox" Grid.Row="4" Width="160" HorizontalAlignment="Left">
            <ComboBoxItem Content="5 minutes"/>
            <ComboBoxItem Content="10 minutes"/>
            <ComboBoxItem Content="15 minutes"/>
            <ComboBoxItem Content="20 minutes"/>
            <ComboBoxItem Content="30 minutes"/>
            <ComboBoxItem Content="45 minutes"/>
            <ComboBoxItem Content="60 minutes"/>
            <ComboBoxItem Content="Custom..."/>
        </ComboBox>

        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,16,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Clean Now" Margin="0,0,8,0" Padding="12,3" Click="CleanNow_Click"/>
            <Button Content="Save" IsDefault="True" Margin="0,0,8,0" Padding="12,3" Click="Save_Click"/>
            <Button Content="Cancel" IsCancel="True" Padding="12,3" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>